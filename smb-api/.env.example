APP_NAME="SMB Device Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# WAJIB PostgreSQL. Lihat docs/database.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smb_local
DB_USERNAME=postgres
DB_PASSWORD=
DB_TEST_DATABASE=smb_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=smb_cache

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lacaksmbbot.com"
MAIL_FROM_NAME="${APP_NAME}"

# §110-114: storage media default = perangkat/server pemilik produk sendiri (bukan cloud).
# SMB_MEDIA_DISK=spaces + isi DO_SPACES_* di bawah kalau nanti mau pindah ke cloud — kode
# tidak perlu diubah (StorageService abstraction, MediaStorageService).
SMB_MEDIA_DISK=smb_media
SMB_STORAGE_PATH=

# DigitalOcean Spaces (§28) — opsional, hanya dipakai kalau SMB_MEDIA_DISK=spaces. Jangan commit nilai asli.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=smb-media
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com

# AdonisJS Gateway internal API (service-to-service)
GATEWAY_INTERNAL_URL=http://127.0.0.1:3333
GATEWAY_INTERNAL_SECRET=

# Telegram Bot (§29) — jangan commit nilai asli
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

SANCTUM_STATEFUL_DOMAINS=localhost:5173,app.lacaksmbbot.com

VITE_APP_NAME="${APP_NAME}"
