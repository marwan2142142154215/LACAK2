TZ=UTC
PORT=3334
HOST=127.0.0.1
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development

# PostgreSQL — SAMA dengan smb-api (lihat smb-api/.env, docker-compose.yml root)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=smb_local
DB_PASSWORD=smb_local_dev_only
DB_DATABASE=smb_local

# Redis (§42)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Internal service-to-service auth dengan Laravel (§3) — jangan commit nilai asli
LARAVEL_INTERNAL_URL=http://127.0.0.1:8000
GATEWAY_INTERNAL_SECRET=

# Device session token signing (§43)
DEVICE_TOKEN_SECRET=
