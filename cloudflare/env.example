# Alternatif ke config.yml + credentials-file: token-based run (lebih sederhana untuk
# single-server setup). Dapatkan token dari dashboard Cloudflare: Zero Trust -> Networks
# -> Tunnels -> (tunnel Anda) -> "Install connector" -> copy token di baris
# `cloudflared service install <TOKEN>`.
#
# Jangan commit file .env berisi nilai asli ini — hanya env.example yang masuk Git.
CLOUDFLARE_TUNNEL_TOKEN=
